# =============================================================================
# EduLearn — environment variables
# =============================================================================
# Copy this file to ".env" and fill in real values before running:
#   cp .env.example .env
# docker compose injects these variables into the services via `env_file`.
# NOTE: docker compose env_file does NOT expand ${...}; values must be literal.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — Spring Boot
# -----------------------------------------------------------------------------
# Active Spring profile: "dev" locally, "prod" when deploying.
SPRING_PROFILES_ACTIVE=dev

# HTTP port exposed by the backend.
SERVER_PORT=8080

# Allowed CORS origins, comma-separated (no spaces).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# JWT signing secret (minimum 32 characters). REQUIRED in production.
JWT_SECRET=replace_with_a_secure_secret_key_at_least_thirty_two_bytes_long
# Optional — uncomment to override the defaults.
# JWT_EXPIRATION=3600000
# JWT_COOKIE_NAME=access_token
# JWT_COOKIE_MAX_AGE=3600
# JWT_COOKIE_SECURE=false
# JWT_COOKIE_SAME_SITE=Lax

# -----------------------------------------------------------------------------
# Email (account verification + password reset)
# -----------------------------------------------------------------------------
# SMTP server. In dev the "dev" profile defaults MAIL_HOST to Mailtrap's sandbox,
# so locally you usually only need MAIL_USERNAME / MAIL_PASSWORD (from your Mailtrap inbox).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# Public URL of the frontend — used to build the links inside the emails.
APP_FRONTEND_URL=http://localhost:5173
# "From" address shown on outgoing emails.
APP_MAIL_FROM=no-reply@edulearn.tn

# Optional — uncomment to override token lifetimes (ISO-8601) and cleanup schedule.
# VERIFICATION_EMAIL_TTL=PT24H
# VERIFICATION_RESET_TTL=PT30M
# APP_TOKEN_CLEANUP_CRON=0 0 3 * * *

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------
# Consumed by the postgres image and its healthcheck.
POSTGRES_DB=edulearn
POSTGRES_USER=edulearn_user
POSTGRES_PASSWORD=changeme

# Spring Boot datasource.
# In docker compose the host is the "db" service name; for local runs use localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/edulearn
SPRING_DATASOURCE_USERNAME=edulearn_user
SPRING_DATASOURCE_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Frontend — Vite
# -----------------------------------------------------------------------------
# Base URL of the backend API as seen from the browser (no trailing slash).
# Leave empty to use the Vite dev proxy.
VITE_API_BASE_URL=http://localhost:8080
