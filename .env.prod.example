# =============================================================================
# EduLearn — environnement de PRODUCTION (modèle)
# =============================================================================
# Copier vers ".env.prod" et remplacer TOUTES les valeurs par de vrais secrets :
#   cp .env.prod.example .env.prod
# Puis : docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# NOTE : VITE_API_BASE_URL n'est pas nécessaire en prod — nginx proxifie /api
# vers le backend, le frontend utilise donc des URLs relatives (même origine).
# =============================================================================

# -----------------------------------------------------------------------------
# Domaine public (HTTPS via Caddy / Let's Encrypt)
# -----------------------------------------------------------------------------
# Un ou plusieurs hôtes séparés par un ESPACE (utilisé par le Caddyfile), ex. :
#   APP_DOMAIN=edulearn.example.com www.edulearn.example.com
APP_DOMAIN=edulearn.example.com

# -----------------------------------------------------------------------------
# Backend — Spring Boot
# -----------------------------------------------------------------------------
SERVER_PORT=8080
# Domaine(s) public(s) autorisés pour CORS (séparés par des virgules, sans espaces).
APP_CORS_ALLOWED_ORIGINS=https://edulearn.example.com

# OBLIGATOIRE : secret fort et unique (min. 32 caractères). NE PAS réutiliser celui de dev.
JWT_SECRET=__CHANGE_ME__generate_a_long_random_secret_of_at_least_32_chars

# -----------------------------------------------------------------------------
# Email (vérification de compte + réinitialisation de mot de passe)
# -----------------------------------------------------------------------------
# OBLIGATOIRE en prod : aucun défaut côté serveur (fail-fast si absent).
# Utiliser un service SMTP transactionnel (SendGrid, Brevo, Mailgun, SES...).
MAIL_HOST=__CHANGE_ME__smtp.votre-fournisseur.com
MAIL_PORT=587
MAIL_USERNAME=__CHANGE_ME__smtp_username
MAIL_PASSWORD=__CHANGE_ME__smtp_password

# Domaine public du frontend : sert à construire les liens dans les emails.
APP_FRONTEND_URL=https://edulearn.example.com
# Adresse expéditeur (doit être autorisée par votre fournisseur SMTP/domaine).
APP_MAIL_FROM=no-reply@edulearn.example.com

# Optionnel — durées de validité (ISO-8601) et planification du nettoyage.
# VERIFICATION_EMAIL_TTL=PT24H
# VERIFICATION_RESET_TTL=PT30M
# APP_TOKEN_CLEANUP_CRON=0 0 3 * * *

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=edulearn
POSTGRES_USER=edulearn_user
# OBLIGATOIRE : mot de passe fort et unique.
POSTGRES_PASSWORD=__CHANGE_ME__strong_database_password

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/edulearn
SPRING_DATASOURCE_USERNAME=edulearn_user
SPRING_DATASOURCE_PASSWORD=__CHANGE_ME__strong_database_password
