# =============================================================================
# Reverse proxy HTTPS (Caddy) — production
# =============================================================================
# Caddy est le routeur unique :
#   - termine le TLS (certificat Let's Encrypt auto-obtenu/renouvelé)
#   - route /api/* vers le backend Spring Boot (même origine → pas de CORS)
#   - sert tout le reste depuis le frontend nginx (fichiers statiques React)
#
# APP_DOMAIN peut contenir un ou plusieurs hôtes séparés par un espace, ex. :
#   APP_DOMAIN=edulearn.tn www.edulearn.tn
# =============================================================================
{$APP_DOMAIN} {
	encode gzip

	# En-têtes de sécurité appliqués à toutes les réponses (Caddy termine le TLS,
	# c'est donc ici que doit vivre HSTS). La CSP n'autorise que les origines
	# réellement utilisées par l'app : polices Google, et embeds YouTube / Drive.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://img.youtube.com https://drive.google.com; frame-src https://www.youtube.com https://drive.google.com; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}

	# API → backend. On utilise "handle" (et non "handle_path") pour CONSERVER
	# le préfixe /api, que le backend attend (ex. /api/auth/login).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Tout le reste → fichiers statiques React servis par nginx.
	handle {
		reverse_proxy frontend:80
	}
}
